# Copiez ce fichier en ".env" en local. Sur Render : Dashboard > Environment (jamais de .env sur GitHub).

# --- Supabase ---
# Adresse du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publique "anon / publishable" (Project Settings > API) : vérifie les connexions utilisateurs
SUPABASE_ANON_KEY=
# Clé SECRÈTE service_role (Project Settings > API) : serveur uniquement, ne la mettez jamais dans le navigateur ni sur GitHub
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications web (navigateurs, PWA) ---
# Clé publique VAPID : générée par la commande  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# Clé privée VAPID (même commande) : secrète
VAPID_PRIVATE_KEY=
# Contact obligatoire pour les services de notification, au format mailto:votre@email.com
VAPID_SUBJECT=mailto:votre@email.com

# --- Notifications Android (application APK) ---
# Contenu COMPLET du fichier JSON de compte de service Firebase (Paramètres du projet > Comptes de service > Générer une clé privée), collé sur une seule ligne
FIREBASE_SERVICE_ACCOUNT=

# --- Administration ---
# E-mail du compte administrateur (en plus des comptes marqués admin dans Supabase)
ADMIN_EMAIL=votre@email.com

# --- Intelligence artificielle (génération de quiz) ---
# Clé du fournisseur d'IA (compatible OpenAI)
AI_API_KEY=
# Adresse de l'API du fournisseur d'IA (laisser vide pour la valeur par défaut du code)
AI_BASE_URL=
# Nom du modèle d'IA à utiliser (laisser vide pour la valeur par défaut du code)
AI_MODEL=

# --- Serveur ---
# Port d'écoute (Render le fournit automatiquement)
PORT=3000
# "production" sur Render, "development" en local
NODE_ENV=production

# --- Journaux et limites (facultatif) ---
# Niveau des journaux JSON : debug, info, warn ou error (défaut : info)
LOG_LEVEL=info
# Requêtes autorisées par minute et par IP sur l'ensemble de /api (défaut : 60)
API_RATE_PER_MIN=60
# Générations IA autorisées par minute et par IP (défaut : 5)
AI_RATE_PER_MIN=5
# Générations IA autorisées par heure et par utilisateur connecté (défaut : 30)
AI_RATE_PER_HOUR=30
# Activations de notifications autorisées par minute et par IP (défaut : 5 ; augmentez-le si tout un campus partage la même IP)
PUSH_SUBSCRIBE_LIMIT=5
