+function mountTableQuestion(i) {
+  const q = examState.questions[i];
+  const host = document.querySelector(`.exam-card[data-qi="${i}"] .table-quiz-host`);
+  if (!host) return;
+  host.textContent = 'Chargement du tableau…';
+  loadModule('table-quiz', 'TableQuiz').then(() => {
+    if (!examState || !host.isConnected) return;
+    window.renderTableQuestion(q, host, {
+      answer: examState.answers[i],
+      locked: isQuestionLocked(i),
+      mode: examState.mode,
+      onChange: (v) => {
+        examState.answers[i] = v;
+        clearTimeout(mountTableQuestion._t);
+        mountTableQuestion._t = setTimeout(() => { if (window.ResumeQuiz && examState) window.ResumeQuiz.save(snapshotExamState()); }, 500);
+      },
+      onVerify: (v) => { examState.answers[i] = v; examState.locked[i] = true; renderExamQuestion(); }
+    });
+  }).catch(() => { host.textContent = '⚠️ Impossible de charger le tableau. Vérifie ta connexion.'; });
