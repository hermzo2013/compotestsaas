+
+// ==========================================
+// 🧩 IMPORT HTML → QUIZ (administrateurs uniquement)
+//    Le parser vit dans /html-quiz-parser.js (chargé à la demande) ; le code collé n'est jamais exécuté.
+// ==========================================
+let importHtmlResult = null;
+const IMPORT_HTML_SAMPLE = [
+  '<!DOCTYPE html>',
+  '<html lang="fr">',
+  '<head>',
+  '<meta charset="UTF-8">',
+  '<title>Statistiques — Quiz de test</title>',
+  '<style>body { font-family: Arial, sans-serif; }</style>',
+  '</head>',
+  '<body>',
+  '<h1>Quiz de statistiques</h1>',
+  '<script>',
+  'const ALL_QUESTIONS = [',
+  '  {',
+  '    id: 1, type: "single",',
+  '    question: "Quelle mesure de tendance centrale est la plus sensible aux valeurs extrêmes ?",',
+  '    options: ["La médiane", "La moyenne", "Le mode", "L\'étendue"],',
+  '    correctAnswers: [1],',
+  '    explanation: "La moyenne prend en compte toutes les valeurs : un point aberrant la déplace fortement."',
+  '  },',
+  '  {',
+  '    id: 2, type: "multiple",',
+  '    question: "Parmi ces mesures, lesquelles sont des mesures de dispersion ?",',
+  '    options: ["La variance", "L\'écart-type", "La médiane", "L\'étendue"],',
+  '    correctAnswers: [0, 1, 3], expectedCount: 3,',
+  '    explanation: "Variance, écart-type et étendue mesurent la dispersion ; la médiane est une mesure de position."',
+  '  },',
+  '  {',
+  '    id: 3, type: "single",',
+  '    question: "Dans une loi normale centrée réduite, quelle est la valeur de la moyenne ?",',
+  '    options: ["0", "1", "−1", "Elle dépend de l\'échantillon"],',
+  '    correctAnswers: [0],',
+  '    explanation: ""',
+  '  },',
+  '  {',
+  '    id: 4,',
+  '    question: "Un test est « significatif » au seuil de 5 % lorsque :",',
+  '    options: ["p < 0,05", "p > 0,05", "p = 1", "p = 0,95"],',
+  '    correctAnswers: [0],',
+  '    explanation: "On rejette H0 quand la valeur p est inférieure au seuil α."',
+  '  },',
+  '  {',
+  '    id: 5, type: "tf",',
+  '    question: "Une corrélation forte entre deux variables prouve qu\'il existe un lien de causalité.",',
+  '    options: ["Vrai", "Faux"],',
+  '    correctAnswers: [1],',
+  '    explanation: "Corrélation n\'est pas causalité : un facteur tiers peut expliquer la relation."',
+  '  }',
+  '];',
+  '<\/script>',
+  '</body>',
+  '</html>'
+].join('\n');
+
+function importHtmlSetNotice(el, cls, html) {
+  el.className = 'notice ' + cls;
+  el.innerHTML = html;
+}
+
+function importHtmlInvalidate() {          // le texte a changé : l'ancienne conversion n'est plus valable
+  importHtmlResult = null;
+  $('ihSavePanel').classList.add('hide');
+  $('ihPreview').classList.add('hide');
+  $('ihSaveStatus').classList.add('hide');
+}
+
+function importHtmlRender(res) {
+  const preview = $('ihPreview');
+  const st = res.stats || {};
+  const n = res.questions.length;
+  const label = { mcq: 'choix unique', mcq_multi: 'choix multiples', tf: 'vrai/faux', short: 'réponse courte' };
+  const types = Object.keys(label).filter(k => st[k]).map(k => st[k] + ' ' + label[k]).join(' • ');
+  const fmt = { js: 'tableau JavaScript', json: 'JSON', html: 'HTML brut' }[res.format] || '';
+  const lim = (arr) => arr.slice(0, 20).map(e => '<li>' + esc(e) + '</li>').join('') + (arr.length > 20 ? '<li>… et ' + (arr.length - 20) + ' autre(s)</li>' : '');
+  let html = n > 0
+    ? '<b>✅ ' + n + ' question' + (n > 1 ? 's' : '') + ' prête' + (n > 1 ? 's' : '') + '</b>' + (fmt ? ' <span style="opacity:.8">(format ' + fmt + ')</span>' : '') + (types ? '<br>' + esc(types) : '')
+    : '<b>⚠️ Aucune question exploitable.</b>';
+  if (res.errors.length) html += '<div style="margin-top:8px"><b>' + res.errors.length + ' erreur(s) — questions ignorées :</b><ul style="margin:4px 0 0 18px">' + lim(res.errors) + '</ul></div>';
+  if (res.warnings && res.warnings.length) html += '<div style="margin-top:8px"><b>' + res.warnings.length + ' avertissement(s) :</b><ul style="margin:4px 0 0 18px">' + lim(res.warnings) + '</ul></div>';
+  importHtmlSetNotice(preview, n > 0 ? (res.errors.length ? '' : 'ok') : 'err', html);
+  $('ihSavePanel').classList.toggle('hide', n === 0);   // « Créer le Quiz » n'apparaît qu'avec au moins 1 question
+}
+
+async function importHtmlConvert() {
+  if (!isAdmin) return;
+  const code = $('ihHtmlInput').value;
+  const btn = $('ihConvertBtn');
+  btn.disabled = true;
+  try {
+    const Parser = await loadModule('html-quiz-parser', 'HtmlQuizParser');
+    const res = Parser.convert(code);
+    importHtmlResult = res.questions.length ? res : null;
+    importHtmlRender(res);
+    if (res.questions.length && !$('ihTitle').value.trim()) {
+      const t = /<title[^>]*>([^<]{1,200})<\/title>/i.exec(code);
+      if (t) $('ihTitle').value = t[1].replace(/\s+/g, ' ').trim();
+    }
+  } catch (e) {
+    importHtmlResult = null;
+    $('ihSavePanel').classList.add('hide');
+    importHtmlSetNotice($('ihPreview'), 'err', '❌ Impossible de charger le convertisseur : ' + esc(e.message || e));
+  } finally { btn.disabled = false; }
+}
+
+async function importHtmlCreate() {
+  if (!isAdmin) return;
+  const status = $('ihSaveStatus');
+  if (!importHtmlResult || !importHtmlResult.questions.length) { importHtmlSetNotice(status, 'err', 'Convertis d\'abord ton code : aucune question à enregistrer.'); return; }
+  const title = $('ihTitle').value.trim();
+  const level = $('ihLevel').value;
+  if (!title) { importHtmlSetNotice(status, 'err', 'Donne un nom au quiz.'); $('ihTitle').focus(); return; }
+  if (!level) { importHtmlSetNotice(status, 'err', 'Choisis un niveau.'); $('ihLevel').focus(); return; }
+  const subject = $('ihSubject').value.trim() || 'Import HTML';
+  const btn = $('ihCreateBtn');
+  btn.disabled = true;
+  importHtmlSetNotice(status, '', 'Enregistrement…');
+  try {
+    // « source: html » sert à afficher le badge HTML dans la bibliothèque, même si la matière est personnalisée
+    const questions = importHtmlResult.questions.map(q => ({ ...q, source: 'html' }));
+    await fetchWithAuth('/api/quizzes', { title, subject, level, questions });
+    importHtmlSetNotice(status, 'ok', '✅ Quiz « ' + esc(title) + ' » créé (' + questions.length + ' question' + (questions.length > 1 ? 's' : '') + ').');
+    importHtmlResult = null;
+    $('ihHtmlInput').value = ''; $('ihTitle').value = ''; $('ihSubject').value = '';
+    $('ihFileName').textContent = 'Aucun fichier';
+    setTimeout(() => { activateTab('library'); }, 700);    // affiche la bibliothèque (rechargée, badge HTML visible)
+  } catch (e) {
+    importHtmlSetNotice(status, 'err', '❌ ' + esc(e.message || 'Erreur lors de l\'enregistrement.'));
+  } finally { btn.disabled = false; }
+}
+
+(function initImportHtmlTab() {
+  const input = $('ihHtmlInput');
+  if (!input) return;
+  input.addEventListener('input', importHtmlInvalidate);
+  $('ihConvertBtn').addEventListener('click', importHtmlConvert);
+  $('ihCreateBtn').addEventListener('click', importHtmlCreate);
+  $('ihSampleBtn').addEventListener('click', () => {
+    if (!isAdmin) return;
+    input.value = IMPORT_HTML_SAMPLE;
+    $('ihFileName').textContent = 'Exemple (5 questions)';
+    importHtmlInvalidate();
+    importHtmlConvert();
+  });
+  $('ihFileBtn').addEventListener('click', () => { if (isAdmin) $('ihFile').click(); });
+  $('ihFile').addEventListener('change', async function () {
+    const f = this.files && this.files[0];
+    this.value = '';
+    if (!f || !isAdmin) return;
+    importHtmlInvalidate();
+    if (f.size > 500 * 1024) {
+      $('ihFileName').textContent = f.name;
+      importHtmlSetNotice($('ihPreview'), 'err', 'Fichier trop volumineux (' + Math.round(f.size / 1024) + ' Ko). Maximum : 500 Ko.');
+      return;
+    }
+    try {
+      input.value = await f.text();
+      $('ihFileName').textContent = f.name;
+      importHtmlConvert();
+    } catch (e) {
+      importHtmlSetNotice($('ihPreview'), 'err', 'Lecture du fichier impossible : ' + esc(e.message || e));
+    }
+  });
+})();
+// ===== IMPORT HTML (fin) =====
 
