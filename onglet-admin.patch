+// ===== ONGLETS : contrôle d'accès selon le rôle =====
+const ADMIN_ONLY_TABS = ['create'];     // onglets réservés aux administrateurs
+const DEFAULT_TAB_ADMIN = 'create';     // onglet affiché par défaut pour un admin
+const DEFAULT_TAB_STUDENT = 'library';  // onglet affiché par défaut pour un étudiant (et repli en cas d'accès refusé)
+let tabsRoleApplied = null;             // 'admin' | 'student' | null : évite de ramener l'utilisateur sur l'onglet par défaut à chaque rafraîchissement de session
+
+function isTabAllowed(name) {
+  return !ADMIN_ONLY_TABS.includes(name) || isAdmin === true;
+}
+
+// Point d'entrée UNIQUE pour changer d'onglet (clic, ?tab=, console...). Refuse les onglets interdits.
+function activateTab(name) {
+  name = String(name || '').replace(/[^a-z-]/g, '');
+  if (!isTabAllowed(name)) name = DEFAULT_TAB_STUDENT;
+  const btn = document.querySelector('.tab[data-tab="' + name + '"]');
+  const target = $('tab-' + name);
+  if (!btn || !target) return false;
+  document.querySelectorAll('.tab').forEach(t => { t.classList.remove('active'); t.removeAttribute('aria-current'); });
+  document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hide'));
+  btn.classList.add('active');
+  btn.setAttribute('aria-current', 'page');
+  target.classList.remove('hide');
+  if (name === 'library') loadLibrary();
+  if (name === 'courses') loadCourses();
+  return true;
+}
+
+// À appeler dans handleSession, une fois isAdmin calculé
+function applyRoleToTabs() {
+  const role = isAdmin ? 'admin' : 'student';
+  document.querySelectorAll('.tab[data-admin-only]').forEach(b => { b.style.display = isAdmin ? '' : 'none'; });
+  document.querySelectorAll('.tab-content[data-admin-only]').forEach(c => { if (!isAdmin) c.classList.add('hide'); });
+  const active = document.querySelector('.tab.active');
+  const activeName = active ? active.dataset.tab : null;
+  // Onglet par défaut : à la connexion / changement de rôle, ou si l'onglet courant n'est plus autorisé
+  if (tabsRoleApplied !== role || !activeName || !isTabAllowed(activeName)) {
+    activateTab(isAdmin ? DEFAULT_TAB_ADMIN : DEFAULT_TAB_STUDENT);
+  }
+  tabsRoleApplied = role;
+}
+
+// À appeler à la déconnexion
+function resetTabsOnLogout() {
+  tabsRoleApplied = null;
+  document.querySelectorAll('.tab[data-admin-only]').forEach(b => { b.style.display = 'none'; });
+  document.querySelectorAll('.tab-content[data-admin-only]').forEach(c => c.classList.add('hide'));
+}
+// ===== ONGLETS (fin) =====
