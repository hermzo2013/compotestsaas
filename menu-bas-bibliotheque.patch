+// Bibliothèque : tant qu'aucun niveau n'est cliqué (et sans recherche), on affiche l'invitation (CSS .lib-await). AJOUT : renderLibraryList / filterLibrary restent inchangées.
+(function () {
+  const tab = $('tab-library'), search = $('quizSearch'), filters = $('libraryFilters');
+  if (!tab || !search || !filters) return;
+  let picked = false;
+  const sync = () => tab.classList.toggle('lib-await', !picked && !search.value.trim());
+  filters.addEventListener('click', (e) => { if (e.target.closest('.level-filter')) { picked = true; sync(); } });
+  search.addEventListener('input', sync);
+})();
